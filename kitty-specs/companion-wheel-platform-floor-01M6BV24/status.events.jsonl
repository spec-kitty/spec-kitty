{"aggregate_id": "01M6BV2418PTM2W673QTQCTWPP", "aggregate_type": "Mission", "event_id": "01M6BV246FGB4WXN58RQKRQAYV", "event_type": "MissionCreated", "payload": {"actor": "22272470+Ivan-Melck@users.noreply.github.com", "created_at": "2026-11-01T15:18:46.208064+00:00", "friendly_name": "companion wheel platform floor", "mission_id": "01M6BV2418PTM2W673QTQCTWPP", "mission_number": null, "mission_slug": "companion-wheel-platform-floor-01M6BV24", "mission_type": "software-dev", "purpose_context": "The companion platform wheel tag states an OS minimum, but nothing read it from the binary. This mission measures the floor from each pinned ELF/Mach-O and refuses a wheel whose tag would understate it (#6948).", "purpose_tldr": "Derive the companion wheel's platform floor from the pinned binary at build time", "target_branch": "issue-6948-companion-wheel-platform-floor", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-11-01T15:18:46.223750+00:00"}
