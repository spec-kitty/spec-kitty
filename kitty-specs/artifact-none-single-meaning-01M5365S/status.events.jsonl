{"aggregate_id": "01M5365S25STVBPMG14B0QGP50", "aggregate_type": "Mission", "event_id": "01M5365W3AHCQ4V4PJJSYHRD7X", "event_type": "MissionCreated", "payload": {"actor": "stijn@spec-kitty.ai", "created_at": "2026-10-16T20:24:08.617531+00:00", "friendly_name": "One meaning for an unclassified mission artifact", "mission_id": "01M5365S25STVBPMG14B0QGP50", "mission_number": null, "mission_slug": "artifact-none-single-meaning-01M5365S", "mission_type": "software-dev", "purpose_context": "When a Mission writes a file the artifact-kind classifier does not recognise, parts of Spec Kitty disagree about where that file lives: the write side keeps it with the mission on the primary branch, but squash consolidation treats it as coordination bookkeeping and can refuse a correct merge on byte-identical content. This mission gives every unclassified artifact one agreed meaning across all consumers and classifies the mission files that were silently unclassified, so consolidation stops failing on content it should accept.", "purpose_tldr": "Stop squash consolidation refusing byte-identical mission files the kind classifier left unclassified.", "target_branch": "fix/artifact-none-single-meaning", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-10-16T20:24:11.626972+00:00"}
