{"aggregate_id": "01M31TAT65CFADCCBFV75TKJFY", "aggregate_type": "Mission", "event_id": "01M31TAT6YAGTZVPKWE9JSGKHN", "event_type": "MissionCreated", "payload": {"actor": "stijn@sddevelopment.be", "created_at": "2026-09-21T11:06:32.532474+00:00", "friendly_name": "Finalize re-pins an orphaned planning_commit_sha after a rebase", "mission_id": "01M31TAT65CFADCCBFV75TKJFY", "mission_number": null, "mission_slug": "finalize-repin-orphaned-planning-commit-01M31TAT", "mission_type": "software-dev", "purpose_context": "When a mission branch is rebased onto a moved base mid-mission, the planning commit is rewritten to a new SHA and the one recorded in lanes.json is orphaned. Today finalize-tasks silently preserves that dead SHA (or refuses to re-point it), so lane allocation and dependency-lane auto-merge fail against a commit that is no longer on the branch \u2014 a P0 wedge on the supported full-mission drive whose only escape is hand-editing lanes.json. This mission makes finalize detect the orphaned pin and re-pin it to the live planning commit, and makes the lane allocator name a stale pin instead of reporting a false merge conflict.", "purpose_tldr": "Stop finalize-tasks from wedging a mission when an upstream rebase orphans the pinned planning commit.", "target_branch": "fix/finalize-repin-orphaned-planning-commit", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-09-21T11:06:32.542093+00:00"}
