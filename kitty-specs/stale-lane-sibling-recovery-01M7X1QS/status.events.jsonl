{"aggregate_id": "01M7X1QSXKVTHS52Z1CQHMVZ03", "aggregate_type": "Mission", "event_id": "01M7X1QVDH9JV008HN5SRBC5F4", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-11-20T17:58:16.258193+00:00", "friendly_name": "Recoverable stale-lane refusal after a halted in-run auto-rebase", "mission_id": "01M7X1QSXKVTHS52Z1CQHMVZ03", "mission_number": null, "mission_slug": "stale-lane-sibling-recovery-01M7X1QS", "mission_type": "software-dev", "purpose_context": "When consolidate refuses a lane as stale after its in-run auto-rebase stops on a conflict with a sibling lane merged earlier in the same run, the operator today gets a remedy that cannot work: the rollback removes the sibling's change from the Mission branch, and the named implement command refuses approved work packages (#7755, #7754).", "purpose_tldr": "Make a consolidate stale-lane refusal name the real cause and a remedy that works for approved work packages.", "target_branch": "fix/7755-stale-lane-auto-rebase-recovery", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-11-20T17:58:16.753258+00:00"}
