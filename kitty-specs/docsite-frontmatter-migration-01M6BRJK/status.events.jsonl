{"aggregate_id": "01M6BRJK82753H4QXJBGCYVQ12", "aggregate_type": "Mission", "event_id": "01M6BRJN3XY30ESYPAJ6619PQH", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-11-01T14:35:21.561307+00:00", "friendly_name": "Docsite build-blocking frontmatter migration", "mission_id": "01M6BRJK82753H4QXJBGCYVQ12", "mission_number": null, "mission_slug": "docsite-frontmatter-migration-01M6BRJK", "mission_type": "software-dev", "purpose_context": "The docsite moves from DocFX to doc-kitty (epic #6100, ADR 2026-10-31-1). Four frontmatter classes in docs/ stop doc-kitty from building the real tree: audience path strings, related repository paths, ADRs without doc_status/kind, and related entries naming unpublished pages. This mission migrates them mechanically, ports the core scripts that read those fields in the same change, and proves the immutable ADR/plan/report/changelog bodies did not change.", "purpose_tldr": "Make the real docs/ tree build on doc-kitty by migrating the build-blocking frontmatter, keeping DocFX and docs query working.", "target_branch": "issue-6929-docsite-frontmatter-migration", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-11-01T14:35:22.109512+00:00"}
