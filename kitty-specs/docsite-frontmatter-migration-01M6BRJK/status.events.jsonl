{"at": "2026-11-01T14:38:42.820904+00:00", "event_id": "01M6BRRS44B1W03NADK8F9Q51F", "event_type": "DecisionPointOpened", "payload": {"actor_id": "cli", "actor_type": "human", "decision_point_id": "01M6BRRS43THXH8SZ861AFG8M3", "input_key": "audience_guidance_text", "mission_id": "01M6BRJK82753H4QXJBGCYVQ12", "mission_slug": "docsite-frontmatter-migration-01M6BRJK", "mission_type": "software-dev", "options": ["Persona-derived sentence: Written for the <persona title> reader.", "Copy the page description", "Leave for #6931 with an empty string", "Other"], "origin_flow": "specify", "origin_surface": "planning_interview", "phase": "SPECIFY", "question": "doc-kitty requires a guidance_text on every audience entry, and the current path-string audience carries none. What should the mechanical migration write?", "recorded_at": "2026-11-01T14:38:42.820904Z", "run_id": "01M6BRRS43THXH8SZ861AFG8M3", "state_entered_at": "2026-11-01T14:38:42.819609Z", "step_id": "specify.audience.guidance-text"}}
