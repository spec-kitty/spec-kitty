{"at": "2026-11-01T15:36:36.394117+00:00", "event_id": "01M6BW2S9A9AFW7RRNZY0M7HE4", "event_type": "DecisionPointOpened", "payload": {"actor_id": "cli", "actor_type": "human", "decision_point_id": "01M6BW2S981SKQWXKCBNQD8RBW", "input_key": "related_source_aware", "mission_id": "01M6BRJK82753H4QXJBGCYVQ12", "mission_slug": "docsite-frontmatter-migration-01M6BRJK", "mission_type": "software-dev", "options": ["Source-aware: published source -> published targets only; draft source -> any non-excluded page; excluded source -> any page", "Uniform: every unpublished target leaves related", "Other"], "origin_flow": "plan", "origin_surface": "planning_interview", "phase": "PLAN", "question": "Which related targets must leave related? The spec said every unpublished target; doc-kitty only resolves related for pages it builds (an excluded page is never built; a draft is built only in a drafts-on preview, where drafts exist but excluded pages never do).", "recorded_at": "2026-11-01T15:36:36.394117Z", "run_id": "01M6BW2S981SKQWXKCBNQD8RBW", "state_entered_at": "2026-11-01T15:36:36.392742Z", "step_id": "plan.related.source-aware-publication"}}
