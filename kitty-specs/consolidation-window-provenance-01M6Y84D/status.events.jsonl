{"aggregate_id": "01M6Y84DMCSNYCP6XTD4C4Q8M6", "aggregate_type": "Mission", "event_id": "01M6Y84DYZQR0WTCSEPJN2YV66", "event_type": "MissionCreated", "payload": {"actor": "stijn.dejongh@sddevelopment.be", "created_at": "2026-11-08T18:53:32.771450+00:00", "friendly_name": "Consolidation window provenance and reconciliation split", "mission_id": "01M6Y84DMCSNYCP6XTD4C4Q8M6", "mission_number": null, "mission_slug": "consolidation-window-provenance-01M6Y84D", "mission_type": "software-dev", "purpose_context": "The consolidation gate decides whether a mission's approved work may land. Today it reconstructs who wrote what from branch history after the fact, each of its checks keeps its own idea of a work package's window, and the dry-run and resume paths feed the gate different inputs, so fixes keep moving problems between checks. This mission records each work package's window when its status changes, gives every caller one shared set of gate inputs, applies the window model to lane missions, fixes two known fail-open defects, and splits the reconciliation module by check without changing verdicts.", "purpose_tldr": "Make the consolidation gate judge each work package against its recorded review window, and split the 4,000-line reconciliation module into one module per check.", "target_branch": "feat/consolidation-window-provenance", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-11-08T18:53:33.023658+00:00"}
