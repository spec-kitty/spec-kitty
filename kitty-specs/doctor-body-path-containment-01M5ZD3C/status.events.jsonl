{"aggregate_id": "01M5ZD3CFFQ845SSCAJ7SV05S0", "aggregate_type": "Mission", "event_id": "01M5ZD3N9F41AANME4MK0NPAF3", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-10-27T19:23:55.763125+00:00", "friendly_name": "Doctor flags org-pack nodes whose body_path escapes the pack", "mission_id": "01M5ZD3CFFQ845SSCAJ7SV05S0", "mission_number": null, "mission_slug": "doctor-body-path-containment-01M5ZD3C", "mission_type": "software-dev", "purpose_context": "A team that shares governance through an org pack relies on doctor charter-packs to say whether the pack is sound. Today a fragment node whose body_path leaves the pack folder (a ../ path or an absolute path) is reported healthy with exit 0, and nothing names the path (#6418, GA-gating P1). This mission makes the doctor run the existing containment check on those nodes and report each escape, so the pack reads unhealthy and the command exits non-zero.", "purpose_tldr": "doctor charter-packs stops reporting a team pack healthy when a node in its graph fragment points outside the pack folder.", "target_branch": "issue-6418-doctor-body-path-containment", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-10-27T19:24:03.247465+00:00"}
