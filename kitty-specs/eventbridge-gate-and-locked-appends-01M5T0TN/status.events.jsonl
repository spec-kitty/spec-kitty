{"aggregate_id": "01M5T0TN104YYNK795CF8A48BH", "aggregate_type": "Mission", "event_id": "01M5T0TVTFV1QE2MP52HGMJ8CW", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-10-25T17:13:14.081367+00:00", "friendly_name": "EventBridge port, event-log writes gate and locked appends", "mission_id": "01M5T0TN104YYNK795CF8A48BH", "mission_number": null, "mission_slug": "eventbridge-gate-and-locked-appends-01M5T0TN", "mission_type": "software-dev", "purpose_context": "ADR 2026-10-14-1 (as amended by ADR 2026-10-22-1) names one canonical event writer behind an EventBridge port. Today nothing implements the port, only status.events.jsonl has a writes gate, and eight logs (decisions, run journal, mission events, Op lifecycle, propagation errors, policy audit, archive registry, encoding provenance) append with an unlocked open('a') that can interleave lines or extend a torn tail, which in decisions.events.jsonl can be committed and travel to other clones. This Mission adds the port skeleton behind the two work package transition doors, a multi-log writes gate frozen at today's writers, and one interim locked append contract that the Java write service (#6193) must interoperate with and that retires at its handover.", "purpose_tldr": "Give every event-log write one door to move behind the Java write service, and stop torn or interleaved lines in the unlocked logs.", "target_branch": "issue-6603-6606-eventbridge-gate-and-locked-appends", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-10-25T17:13:19.951219+00:00"}
