{"aggregate_id": "01M78WZM48VJHP4HJVHKG2FDBN", "aggregate_type": "Mission", "event_id": "01M78WZWHD729212CTP5MQ47ZH", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-11-12T22:10:28.120203+00:00", "friendly_name": "Rename section indexes to README.md; docs staleness inventory and retired-surface gate", "mission_id": "01M78WZM48VJHP4HJVHKG2FDBN", "mission_number": null, "mission_slug": "readme-rename-and-docs-audit-01M78WZM", "mission_type": "software-dev", "purpose_context": "DocFX is retired (#6943), so ADR 2026-10-31-1 D-1/D-13 step 5 lets every docs/**/index.md become README.md with indexBasename narrowed to README. Links are rewritten through site/moves.yaml and every legacy URL stays covered. On the final paths, the content-refresh epic #3891 needs an audit first: a reproducible inventory of every published living page (last real content change, named code paths and commands, target reader, retired-surface references, text-drawn diagrams, Divio type) and a gate that fails when a page newly names a retired surface, with existing hits in a shrink-only burn-down list pointing at the section sub-issues.", "purpose_tldr": "Rename the docs section index.md pages to README.md (#6939), then generate a staleness inventory of published living pages and gate new retired-surface references (#7520)", "target_branch": "issue-6939-readme-rename-and-audit", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-11-12T22:10:28.525745+00:00"}
