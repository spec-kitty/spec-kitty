{"aggregate_id": "01M55KGYSD1T77BFVSD0JFHJF6", "aggregate_type": "Mission", "event_id": "01M55KGYWQ02DKYNBRDJ3X6A0A", "event_type": "MissionCreated", "payload": {"actor": "test@test.com", "created_at": "2026-10-17T18:55:55.270349+00:00", "friendly_name": "Owned issue-verdict authority", "mission_id": "01M55KGYSD1T77BFVSD0JFHJF6", "mission_number": null, "mission_slug": "owned-issue-verdict-authority-01M55KGY", "mission_type": "software-dev", "purpose_context": "The issue-verdict command is the twin of the acceptance-verdict gap fixed in #6023. For an owned-only PR-bound single_branch mission, it resolves against the repository root and its fail-closed resolve_for_write write-target gate refuses, so criterion verdicts for cited issues cannot be recorded through the owned-checkout route. This mission threads the owned-checkout fact through the command and the shared mission_runtime write-target gate so owned verdicts land, mirroring #6023.", "purpose_tldr": "Let an owned-only mission record issue-matrix verdicts through issue-verdict --owned-checkout.", "target_branch": "kitty-base-6320", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-10-17T18:55:55.287799+00:00"}
