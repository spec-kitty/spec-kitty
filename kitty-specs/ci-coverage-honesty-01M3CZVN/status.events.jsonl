{"aggregate_id": "01M3CZVN0ECC1E8FS3SWKZ2FK1", "aggregate_type": "Mission", "event_id": "01M3CZVN18QSH7KPCJ8XJ1KWER", "event_type": "MissionCreated", "payload": {"actor": "stijn@sddevelopment.be", "created_at": "2026-09-25T19:14:45.918220+00:00", "friendly_name": "CI Coverage Honesty", "mission_id": "01M3CZVN0ECC1E8FS3SWKZ2FK1", "mission_number": null, "mission_slug": "ci-coverage-honesty-01M3CZVN", "mission_type": "software-dev", "purpose_context": "Spec Kitty's per-module CI selector keys test shards on source roots without modeling which source each test exercises, so cross-cutting and unenrolled test suites are silently skipped on main pushes. Real regressions have shipped to a green main undetected. This mission makes coverage honest: it enforces that every shard tests its own source and every source package is reachable by an in-matrix test, enrolls the dark suites, and makes hidden nightly failures self-surfacing so 'main is green' is a truthful signal stakeholders can trust for release decisions.", "purpose_tldr": "Make a green main mean the tests actually ran: close the CI shard-selection blind spots that let regressions ship undetected.", "target_branch": "feat/ci-coverage-honesty", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-09-25T19:14:45.928343+00:00"}
