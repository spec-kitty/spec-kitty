{"aggregate_id": "01M31T5SRZDJ147ZEZG49HQNPV", "aggregate_type": "Mission", "event_id": "01M31T5SSRYQQM9WBARX3PJSXM", "event_type": "MissionCreated", "payload": {"actor": "stijn@sddevelopment.be", "created_at": "2026-09-21T11:03:48.269793+00:00", "friendly_name": "CI: down-route prose-only .py diffs off the code matrix", "mission_id": "01M31T5SRZDJ147ZEZG49HQNPV", "mission_number": null, "mission_slug": "ci-prose-only-downroute-01M31T5S", "mission_type": "software-dev", "purpose_context": "The CI path router classifies any src/**.py or tests/**.py edit as a full code change, so a comment/docstring-only PR runs ~2 hours of aggregate shard compute it cannot possibly affect while the docs lane skips. This mission adds content-based prose-only detection that down-routes an all-prose-only PR off the code matrix and arch battery, keeps lint/terminology/help-drift/doctest lanes, and fails closed to full routing on any uncertainty. Issue #4842 under CI-honesty epic #4437.", "purpose_tldr": "Stop docstring/comment-only Python PRs from fanning out the full CI code test matrix and heavy arch battery.", "target_branch": "feat/ci-prose-only-downroute", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-09-21T11:03:48.280322+00:00"}
