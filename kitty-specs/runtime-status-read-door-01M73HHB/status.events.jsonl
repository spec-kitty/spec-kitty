{"aggregate_id": "01M73HHBGCYKH10797R6YR21WS", "aggregate_type": "Mission", "event_id": "01M73HHDKR35YX0AGHBZN1PNK5", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-11-10T20:14:07.502269+00:00", "friendly_name": "Runtime status readers through the read door", "mission_id": "01M73HHBGCYKH10797R6YR21WS", "mission_number": null, "mission_slug": "runtime-status-read-door-01M73HHB", "mission_type": "software-dev", "purpose_context": "The runtime decision path behind spec-kitty next still reads work-package status through an older path that misses status committed on the coordination branch, so a coordination Mission whose coordination checkout is empty reports no actionable work and zero progress (#7507). This Mission moves those readers onto the one status read door that the rest of the CLI already uses (#7310), keeps owned-checkout and coordination safety refusals where the operator ruled they belong, and adds an opt-in way for next to set up a missing coordination checkout itself.", "purpose_tldr": "Make spec-kitty next and its status queries read Mission status from one declared source, so a coordination Mission never shows an empty board while its lanes are committed.", "target_branch": "refactor/7310-status-read-door-s5", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-11-10T20:14:07.992388+00:00"}
