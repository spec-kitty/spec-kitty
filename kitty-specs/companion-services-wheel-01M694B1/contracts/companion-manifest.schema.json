{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "spec-kitty-services companion manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cli_version", "target", "services"],
  "properties": {
    "schema": {"const": 1},
    "cli_version": {"type": "string", "minLength": 1},
    "target": {"enum": ["linux-x64", "linux-arm64", "macos-arm64", "windows-x64", null]},
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "tag", "asset", "sha256"],
        "properties": {
          "service": {"enum": ["write-service", "charter-service"]},
          "tag": {"type": "string", "pattern": "^service-v"},
          "asset": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
