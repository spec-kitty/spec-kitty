{"aggregate_id": "01M3GSSVSVH0CNBPQVME3KY7GA", "aggregate_type": "Mission", "event_id": "01M3GSSVTJN5AY8N32C9V29H4C", "event_type": "MissionCreated", "payload": {"actor": "stijn@sddevelopment.be", "created_at": "2026-09-27T06:45:53.608819+00:00", "friendly_name": "Consolidate: canonical lane-consolidation terminology", "mission_id": "01M3GSSVSVH0CNBPQVME3KY7GA", "mission_number": null, "mission_slug": "consolidate-canonical-terminology-01M3GSSV", "mission_type": "software-dev", "purpose_context": "The word 'merge' currently carries three distinct meanings in Spec Kitty (fold the lanes, git-integrate two refs, publish to trunk), and that overload has already produced false review verdicts. This mission promotes 'consolidate'/'consolidation' to the single canonical term for the lane-consolidation sense across the command, code identifiers, docs, prompt templates, the mission gate-step name, and a drift guard, while keeping 'spec-kitty merge' working as a deprecated alias so no user is hard-broken.", "purpose_tldr": "Give the lane-consolidation operation one canonical word \u2014 consolidate \u2014 so operators, agents, and reviewers never confuse it with git-merge or publish.", "target_branch": "feat/consolidate-canonical-terminology", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-09-27T06:45:53.618088+00:00"}
