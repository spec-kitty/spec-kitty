{"aggregate_id": "01M66YYX43K243WESFE0QRZ1MJ", "aggregate_type": "Mission", "event_id": "01M66YZ0ZCQPDFVRBG7NTQ7YF7", "event_type": "MissionCreated", "payload": {"actor": "cli", "created_at": "2026-10-30T17:50:42.949678+00:00", "friendly_name": "Caller-supplied migration actors are not reconstruction seeds", "mission_id": "01M66YYX43K243WESFE0QRZ1MJ", "mission_number": null, "mission_slug": "migration-actor-cli-spoofing-01M66YYX", "mission_type": "software-dev", "purpose_context": "A reconstruction seed is a best-effort restatement of history, exempt from consolidation work windows, timestamp continuity and the review-exit note rule. Today any caller can pass --actor migration:anything to a status writer and produce one, so a live transition can be made to look like reconstruction. This Mission makes the capability belong to in-process migration writers alone: a caller-supplied seed-shaped identity is refused before any write, while recorded seeds and the in-process backfills keep working unchanged.", "purpose_tldr": "Refuse a caller-supplied 'migration:' identity at every status boundary that records it verbatim, so only in-process migrations can write reconstruction seeds (#6754).", "target_branch": "issue-6754-migration-actor-cli-spoofing", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-10-30T17:50:46.764934+00:00"}
