{"aggregate_id": "01M1CA8WD0HSRY5MAJ3WR3DM3A", "aggregate_type": "Mission", "event_id": "01M1CA8X4QDBMT6TXVT1ARPRKE", "event_type": "MissionCreated", "payload": {"created_at": "2026-08-31T16:26:07.137430+00:00", "friendly_name": "Next Resolves State From Committed Authority", "mission_id": "01M1CA8WD0HSRY5MAJ3WR3DM3A", "mission_number": null, "mission_slug": "next-committed-state-authority-01M1CA8W", "mission_type": "software-dev", "purpose_context": "When a mission has already merged, or an operator has deliberately canceled a work package, the mission loop should recognize that from the authoritative committed record. Today it can instead read a stale coordination checkout or a lane value in isolation, causing it to restart finished work or refuse to move past an honest ending. This mission routes the loop's state decisions through committed status and the existing operator-provenance authority, and fails closed (blocked/error) when the workspace is stale or missing artifacts rather than pretending the work never started.", "purpose_tldr": "spec-kitty next reads committed mission status and operator provenance \u2014 never a stale worktree or lane alone \u2014 so merged missions aren't restarted and operator-canceled work doesn't stall the loop.", "target_branch": "fix/next-committed-state-authority", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-08-31T16:26:07.895762+00:00"}
