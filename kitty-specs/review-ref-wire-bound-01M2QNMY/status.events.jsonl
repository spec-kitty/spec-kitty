{"aggregate_id": "01M2QNMY7RBESVYKPDD6R7XXRD", "aggregate_type": "Mission", "event_id": "01M2QNMY815PGGQDN61Z9YGNXD", "event_type": "MissionCreated", "payload": {"actor": "stijn@sddevelopment.be", "created_at": "2026-09-17T12:32:17.148996+00:00", "friendly_name": "Bound review_ref at the WPStatusChanged wire projection", "mission_id": "01M2QNMY7RBESVYKPDD6R7XXRD", "mission_number": null, "mission_slug": "review-ref-wire-bound-01M2QNMY", "mission_type": "software-dev", "purpose_context": "On main, move-task with a review note >240 UTF-8 bytes makes the events codec raise ZeitgeistAttrsOverflowError on review_ref, so the whole WPStatusChanged moment is dropped and no relay broadcast happens. This launch-critical MVP-interim bounds only legacy prose review_ref at the zeitgeist_bridge wire-projection boundary (collapse to one line, cap at 240 bytes with a trailing ellipsis, never truncate pointer-shaped values) while the canonical local status event log keeps the full note. The structural fix (dedicated summary attr, review_ref pointer-only) stays post-MVP in #4327.", "purpose_tldr": "MVP-interim: stop dropping WPStatusChanged moments when an approval/rejection carries a review note over 240 bytes (#3954)", "target_branch": "main", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-09-17T12:32:17.153675+00:00"}
