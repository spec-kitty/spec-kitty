{"aggregate_id": "01M6P49EBJZ15Q06S9XYQE61HX", "aggregate_type": "Mission", "event_id": "01M6P49Q3KRBZG4PHXVC1NXS3J", "event_type": "MissionCreated", "payload": {"actor": "22272470+Ivan-Melck@users.noreply.github.com", "created_at": "2026-11-05T15:12:27.672245+00:00", "friendly_name": "Corpus advisory suite budget you can defend", "mission_id": "01M6P49EBJZ15Q06S9XYQE61HX", "mission_number": null, "mission_slug": "corpus-advisory-budget-01M6P49E", "mission_type": "software-dev", "purpose_context": "Issue #7206: the advisory Packs corpus suite runs at its 20-minute budget (measured p95 20.3 min, 102% of cap) and cancels on unrelated PRs. This mission records the measured cost breakdown, derives the cap with the repository's #5378 headroom formula, enforces it with a guard, and makes a budget expiry legible as INCOMPLETE (#4437) without touching selection semantics.", "purpose_tldr": "Derive the advisory corpus job's timeout from its measured worst case and make a budget expiry read as incomplete advisory, not a failed test.", "target_branch": "issue-7206-corpus-advisory-budget", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-11-05T15:12:36.467945+00:00"}
