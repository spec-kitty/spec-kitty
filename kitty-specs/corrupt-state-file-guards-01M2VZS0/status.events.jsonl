{"aggregate_id": "01M2VZS0CCRB5WVCYYREGJ3718", "aggregate_type": "Mission", "event_id": "01M2VZS0D3S2PRC502HR4563YM", "event_type": "MissionCreated", "payload": {"actor": "stijn@sddevelopment.be", "created_at": "2026-09-19T04:46:13.914182+00:00", "friendly_name": "Corrupt per-mission state files fail closed, not crash", "mission_id": "01M2VZS0CCRB5WVCYYREGJ3718", "mission_number": null, "mission_slug": "corrupt-state-file-guards-01M2VZS0", "mission_type": "software-dev", "purpose_context": "When a per-mission state file (meta.json, decisions/index.json) is left malformed by a partial write or merge conflict, core CLI commands currently crash with a raw Python traceback. This mission makes those commands fail closed with a single readable error so operators \u2014 and the agent control loop that calls next repeatedly \u2014 degrade gracefully instead of breaking on already-corrupt state.", "purpose_tldr": "A corrupt mission state file yields a clean operator error and non-zero exit, never an uncaught traceback.", "target_branch": "fix/4642-corrupt-state-file-guards", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-09-19T04:46:13.923081+00:00"}
