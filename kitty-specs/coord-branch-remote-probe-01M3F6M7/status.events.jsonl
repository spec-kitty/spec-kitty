{"aggregate_id": "01M3F6M7P4V0C77YPPV27Y5V9N", "aggregate_type": "Mission", "event_id": "01M3F6M7PKCQ5M50CGD7BEBZAD", "event_type": "MissionCreated", "payload": {"actor": "stijn@sddevelopment.be", "created_at": "2026-09-26T15:51:31.792530+00:00", "friendly_name": "Coordination branch remote-existence probe", "mission_id": "01M3F6M7P4V0C77YPPV27Y5V9N", "mission_number": null, "mission_slug": "coord-branch-remote-probe-01M3F6M7", "mission_type": "software-dev", "purpose_context": "A single-branch/shallow/CI clone (or pruned origin ref) has no local or remote-tracking ref for the coordination branch though it exists on origin. The coord read-path and doctor coordination --fix read that absence as 'never created' and flatten the mission; implement then auto-commits the flatten to the target branch, hiding every teammate's approvals on pull. Teach the branch-existence probe to consult the remote authority, guard the doctor flatten site, and stop implement's auto-commit from carrying a topology demotion.", "purpose_tldr": "Stop doctor --fix flattening a live coord mission from a checkout that can't see the remote coordination branch", "target_branch": "issue-4979-coord-branch-remote-probe", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-09-26T15:51:31.795881+00:00"}
