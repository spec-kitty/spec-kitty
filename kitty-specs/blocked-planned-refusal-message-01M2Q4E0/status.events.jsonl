{"aggregate_id": "01M2Q4E0YS3TP1K9H6KFPQWXB5", "aggregate_type": "Mission", "event_id": "01M2Q4E0ZJZ7BPH1HDAD6D1CSR", "event_type": "MissionCreated", "payload": {"actor": "stijn@sddevelopment.be", "created_at": "2026-09-17T07:31:24.776380+00:00", "friendly_name": "Source-aware unblock refusal message", "mission_id": "01M2Q4E0YS3TP1K9H6KFPQWXB5", "mission_number": null, "mission_slug": "blocked-planned-refusal-message-01M2Q4E0", "mission_type": "software-dev", "purpose_context": "When a work package is blocked, trying to move it back to planned currently fails with a source-agnostic 'requires review feedback' error, even though the honest recovery is to resume (in_progress) or cancel. This mission makes that refusal message source-aware without weakening the force-proof guard, closing P0 issue #3937 (F-51).", "purpose_tldr": "Tell operators the real recovery path when a work package cannot move to planned, instead of a misleading demand for review feedback.", "target_branch": "issue-3937-blocked-planned-refusal-message", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-09-17T07:31:24.786602+00:00"}
