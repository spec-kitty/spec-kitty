{"aggregate_id": "01M81KRSCYPVJE3WS74AE674YP", "aggregate_type": "Mission", "event_id": "01M81KS08KCEH5Q3SHRA8FT662", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-11-22T12:30:25.930271+00:00", "friendly_name": "single_branch planning pin across a rebase", "mission_id": "01M81KRSCYPVJE3WS74AE674YP", "mission_number": null, "mission_slug": "single-branch-planning-pin-rebase-01M81KRS", "mission_type": "software-dev", "purpose_context": "After a mid-mission rebase, finalize-tasks --refresh-planning-commit --allow-orphaned re-points planning_commit_sha to the branch tip, the single_branch evidence window planning_commit..mission_branch empties, and move-task refuses SINGLE_BRANCH_IMPLEMENTATION_MISSING (#7793). The same pin authority also replaces a derived pin on a later plain finalize, walks the wrong branch, prints messages that disagree, can be too early or too late, and leaves doctor gaps (#7297 items 1-6).", "purpose_tldr": "Keep the single_branch planning pin on the planning commit across a rebase, so the implementation evidence window never empties.", "target_branch": "issue-7793-single-branch-planning-pin", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-11-22T12:30:26.579715+00:00"}
