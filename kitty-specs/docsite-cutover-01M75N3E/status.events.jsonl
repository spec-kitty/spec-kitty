{"aggregate_id": "01M75N3EP8TZGK6HW8Y5JYYW9Y", "aggregate_type": "Mission", "event_id": "01M75N3GDQ2K77E2V3974CBEK7", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-11-11T15:54:54.786333+00:00", "friendly_name": "Docsite cutover to doc-kitty", "mission_id": "01M75N3EP8TZGK6HW8Y5JYYW9Y", "mission_number": null, "mission_slug": "docsite-cutover-01M75N3E", "mission_type": "software-dev", "purpose_context": "The canary proved GitHub Pages serves the doc-kitty build's URL classes. This mission switches the docs-pages.yml deploy from DocFX to the doc-kitty artifact built by the shared docs-site-build.yml, so main deploys only a site the pull-request gate's build definition built (ADR D-11). After each deploy a smoketest job runs the ledger-derived live-site probe against docs.spec-kitty.ai and turns the run red on a mismatch (#2361). The hand-written docs/llms.txt is deleted, since the site generates /llms.txt. Rollback is reverting the pull request.", "purpose_tldr": "Main deploys the doc-kitty build through the shared build definition, a post-deploy smoketest probes the live site, and docs/llms.txt is deleted (#6938 PR B, #2361)", "target_branch": "issue-6938-docsite-cutover", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-11-11T15:54:55.287919+00:00"}
