{"at": "2026-11-11T15:57:06.717156+00:00", "event_id": "01M75N7GRX8WW2B731VJZ10ZVV", "event_type": "DecisionPointOpened", "payload": {"actor_id": "cli", "actor_type": "human", "decision_point_id": "01M75N7GRV1N8ACM65N2G219KB", "input_key": "canary_and_docfx_fate", "mission_id": "01M75N3EP8TZGK6HW8Y5JYYW9Y", "mission_slug": "docsite-cutover-01M75N3E", "mission_type": "software-dev", "options": [], "origin_flow": "plan", "origin_surface": "planning_interview", "phase": "PLAN", "question": "What happens to the canary jobs and to the DocFX build in docs-pages.yml?", "recorded_at": "2026-11-11T15:57:06.717156Z", "run_id": "01M75N7GRV1N8ACM65N2G219KB", "state_entered_at": "2026-11-11T15:57:06.715865Z", "step_id": "plan.architecture.canary-and-docfx"}}
{"at": "2026-11-11T15:57:09.245192+00:00", "event_id": "01M75N7K7XG8AQR6Y3HTS39418", "event_type": "DecisionPointResolved", "payload": {"actual_participants": [], "closed_locally_while_widened": false, "closure_message": null, "decision_point_id": "01M75N7GRV1N8ACM65N2G219KB", "final_answer": "One live-probe mechanism: the canary jobs (canary-build, canary-deploy, canary-probe) and the canary dispatch input are removed; the post-deploy smoketest reuses the same probe on every deploy, so a canary of the current site would be a second, redundant path. The DocFX build job is removed from docs-pages.yml as well: it would build a site nothing publishes, and a DocFX failure would turn a successful doc-kitty deploy red. The DocFX sources (docfx.json, toc.yml, the template, scripts and their tests) stay until #6943; a revert of this PR restores the DocFX build and deploy jobs and the canary. Brief-derived engineering decision.", "mission_id": "01M75N3EP8TZGK6HW8Y5JYYW9Y", "mission_slug": "docsite-cutover-01M75N3E", "mission_type": "software-dev", "origin_surface": "planning_interview", "other_answer": false, "rationale": null, "recorded_at": "2026-11-11T15:57:09.245192Z", "resolved_by": "cli", "run_id": "01M75N7GRV1N8ACM65N2G219KB", "state_entered_at": "2026-11-11T15:57:09.243870Z", "summary": null, "terminal_outcome": "resolved"}}
