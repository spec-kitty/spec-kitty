{"at": "2026-11-11T15:57:14.242964+00:00", "event_id": "01M75N7R43T0TNQ3D77M7E3Q3W", "event_type": "DecisionPointResolved", "payload": {"actual_participants": [], "closed_locally_while_widened": false, "closure_message": null, "decision_point_id": "01M75N7NP8ETY796W2EJRYXK7D", "final_answer": "Workflow default contents: read. pages job: pages: read (GET the Pages site and configure-pages without enablement read only). build job (calls the shared build): contents: read. deploy: pages: write and id-token: write, nothing else. smoketest: contents: read. Brief-derived engineering decision.", "mission_id": "01M75N3EP8TZGK6HW8Y5JYYW9Y", "mission_slug": "docsite-cutover-01M75N3E", "mission_type": "software-dev", "origin_surface": "planning_interview", "other_answer": false, "rationale": null, "recorded_at": "2026-11-11T15:57:14.242964Z", "resolved_by": "cli", "run_id": "01M75N7NP8ETY796W2EJRYXK7D", "state_entered_at": "2026-11-11T15:57:14.241606Z", "summary": null, "terminal_outcome": "resolved"}}
