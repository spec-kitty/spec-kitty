{"aggregate_id": "01M37PWGWRFNZY8X2Y7P7KJJGK", "aggregate_type": "Mission", "event_id": "01M37PWGXDJJNMCHY04EWRK1R5", "event_type": "MissionCreated", "payload": {"actor": "stijn@sddevelopment.be", "created_at": "2026-09-23T18:01:45.124653+00:00", "friendly_name": "Mission-State Repair Audit-Trail Durability", "mission_id": "01M37PWGWRFNZY8X2Y7P7KJJGK", "mission_number": null, "mission_slug": "mission-state-audit-trail-durability-01M37PWG", "mission_type": "software-dev", "purpose_context": "The mission-state repair records what it did (a per-run manifest) and where it put any rows it removed (a quarantine tree) under a git-ignored path, so a routine working-tree clean destroys the only evidence of a destructive repair and the operator is never warned. This mission makes that audit trail durable and visible. It is the placement/visibility sibling of the row-canonicality fix already shipped for #4897; it deliberately does not touch which rows are preserved.", "purpose_tldr": "Make 'doctor mission-state --fix' keep a durable, visible audit trail so its repair manifest and any quarantined rows can't silently vanish under git clean (#4928).", "target_branch": "fix/mission-state-audit-trail-durability", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-09-23T18:01:45.133417+00:00"}
