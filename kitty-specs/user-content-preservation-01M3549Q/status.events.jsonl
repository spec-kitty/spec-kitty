{"aggregate_id": "01M3549Q1JZYMX2V648F15ACZY", "aggregate_type": "Mission", "event_id": "01M3549Q28F8KQR7BCBZSMXZ6X", "event_type": "MissionCreated", "payload": {"actor": "stijn@sddevelopment.be", "created_at": "2026-09-22T17:58:25.598868+00:00", "friendly_name": "User-content preservation for mutating flows", "mission_id": "01M3549Q1JZYMX2V648F15ACZY", "mission_number": null, "mission_slug": "user-content-preservation-01M3549Q", "mission_type": "software-dev", "purpose_context": "A cluster of catfooding defects (epic #4915) shows ordinary Spec Kitty commands destroying operator-authored content \u2014 custom slash commands, git hooks, hand-written briefs, spec files \u2014 with exit 0 and no backup or warning. This mission enforces the charter's existing User Customization Preservation invariant across the remaining mutating flows so the tool never fights its own operator.", "purpose_tldr": "Spec Kitty's mutating commands must never silently overwrite, delete, or corrupt user-authored files while reporting success.", "target_branch": "fix/user-content-preservation", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-09-22T17:58:25.608393+00:00"}
