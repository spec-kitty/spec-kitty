{"at": "2026-09-22T17:59:20.526679+00:00", "event_id": "01M354BCPEAH6CPXGSHMY0B9XK", "event_type": "DecisionPointOpened", "payload": {"actor_id": "cli", "actor_type": "human", "decision_point_id": "01M354BCPEAH6CPXGSHMY0B9XJ", "input_key": "overwrite_behavior", "mission_id": "01M3549Q1JZYMX2V648F15ACZY", "mission_slug": "user-content-preservation-01M3549Q", "mission_type": "software-dev", "options": ["refuse+force", "backup+warn", "hybrid-per-flow"], "origin_flow": "specify", "origin_surface": "planning_interview", "phase": "SPECIFY", "question": "When a mutating flow is about to overwrite a pre-existing user-authored file it did not create, what is the contract?", "recorded_at": "2026-09-22T17:59:20.526679Z", "run_id": "01M354BCPEAH6CPXGSHMY0B9XJ", "state_entered_at": "2026-09-22T17:59:20.526089Z", "step_id": "specify.contract.overwrite-behavior"}}
