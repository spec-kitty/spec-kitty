{"aggregate_id": "01M56P1SC40TNTJ070H1SB430S", "aggregate_type": "Mission", "event_id": "01M56P1WA18QCYHWAH8K74YCSV", "event_type": "MissionCreated", "payload": {"actor": "stijn@spec-kitty.ai", "created_at": "2026-10-18T04:59:18.381561+00:00", "friendly_name": "Fix charter preflight blocking next on a fresh checkout", "mission_id": "01M56P1SC40TNTJ070H1SB430S", "mission_number": null, "mission_slug": "charter-preflight-fresh-checkout-01M56P1S", "mission_type": "software-dev", "purpose_context": "A freshly-cloned owned checkout whose committed charter synthesis-manifest stamps a bundle_content_hash that no longer matches a recompute of charter.yaml is hard-blocked by spec-kitty next with CHARTER_PREFLIGHT_FAILED (synthesized_drg stale). This blocks a real golden-path operator and is a release blocker (#6366). The mission fixes charter-content/stamp parity at the single hash authority and/or auto-heals the read path so a fresh checkout is never terminally blocked, with a per-PR regression twin so it cannot hide on the nightly cadence again.", "purpose_tldr": "Stop a freshly-cloned/built-in checkout from being hard-blocked by a stale charter synthesized-DRG preflight when running spec-kitty next.", "target_branch": "fix/charter-preflight-fresh-checkout", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-10-18T04:59:21.281455+00:00"}
