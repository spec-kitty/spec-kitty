{"aggregate_id": "01M319HSN3ZVHE3QPGZDH3J8ST", "aggregate_type": "Mission", "event_id": "01M319HSNWCN0K2HQ3MB8APEK4", "event_type": "MissionCreated", "payload": {"actor": "stijn@sddevelopment.be", "created_at": "2026-09-21T06:13:15.568993+00:00", "friendly_name": "Auth token-target issuer guard", "mission_id": "01M319HSN3ZVHE3QPGZDH3J8ST", "mission_number": null, "mission_slug": "token-target-issuer-guard-01M319HS", "mission_type": "software-dev", "purpose_context": "A P0 credential-exposure fix: four token-bearing auth flows (refresh, logout/revoke, membership rehydrate, websocket token provisioning) currently ignore the configured server and the session's own issuer, so self-hosted users leak tokens to the public host and a hostile checkout can exfiltrate a refresh token. This mission routes every token-bearing call to the session's issuer, refuses on mismatch, and fences the unsafe accessor so the class cannot recur.", "purpose_tldr": "Stop the CLI from POSTing refresh/access tokens to the wrong server.", "target_branch": "issue-4755-token-target-issuer-guard", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-09-21T06:13:15.580412+00:00"}
