{"aggregate_id": "01M49DF438J37NQPMRJ7N51CN7", "aggregate_type": "Mission", "event_id": "01M49DF6YGBTCGMDB5DDQ590JD", "event_type": "MissionCreated", "payload": {"actor": "stijn@spec-kitty.ai", "created_at": "2026-10-06T20:11:19.629403+00:00", "friendly_name": "Cutover guard exempts pre-accept Missions", "mission_id": "01M49DF438J37NQPMRJ7N51CN7", "mission_number": null, "mission_slug": "cutover-guard-pre-accept-exemption-01M49DF4", "mission_type": "software-dev", "purpose_context": "A Mission driven only by canonical commands goes red on the cutover-guard check from its first PR push, because the status_phase stamp is deferred to accept by design while the guard checks every touched Mission. Operators currently have to run a legacy migration by hand. This mission makes the guard recognise pre-accept, event-log-native Missions while staying strict for accepted corpora and legacy Missions.", "purpose_tldr": "Stop the cutover-guard CI check from failing every in-flight PR-bound Mission before it is accepted.", "target_branch": "fix/cutover-guard-pre-accept-exemption", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-10-06T20:11:22.448083+00:00"}
