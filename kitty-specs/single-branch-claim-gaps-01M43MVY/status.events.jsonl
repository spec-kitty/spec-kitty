{"aggregate_id": "01M43MVY8TPQYNA0S9SF057V4C", "aggregate_type": "Mission", "event_id": "01M43MW2G7J10GDMSX994Z5RZV", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-10-04T14:25:14.308513+00:00", "friendly_name": "single_branch claim gaps: stale occupant and claim base", "mission_id": "01M43MVY8TPQYNA0S9SF057V4C", "mission_number": null, "mission_slug": "single-branch-claim-gaps-01M43MVY", "mission_type": "software-dev", "purpose_context": "single_branch work-package claims are refused WRITE_CHECKOUT_OCCUPIED by an in_progress WP of an already merged mission (#5680), and agent action implement was reported never to record the claim base (#5663). This mission makes occupancy track the live status surface and verifies the claim-base path, so operators can claim single_branch work without --force.", "purpose_tldr": "Stop a finished mission's stale in_progress WP from blocking every single_branch claim, and confirm agent claims record their claim base", "target_branch": "issue-5680-single-branch-claim-gaps", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-10-04T14:25:17.320019+00:00"}
