{"aggregate_id": "01M3MQV6NZ0XKR6VZX0PC14K0D", "aggregate_type": "Mission", "event_id": "01M3MQV7Y51EDS963R3PT8QRPK", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-09-28T19:28:39.359278+00:00", "friendly_name": "Rework is not an override", "mission_id": "01M3MQV6NZ0XKR6VZX0PC14K0D", "mission_number": null, "mission_slug": "rework-is-not-an-override-01M3MQV6", "mission_type": "software-dev", "purpose_context": "Today an implementer resubmitting rework after a rejection, and a reviewer approving it, both need --force because of the agent-ownership guard, and the forced resubmission is misclassified as an arbiter override (rejected \u2192 overridden). This mission makes the ordinary rework loop unforced and restricts arbiter-override recording to genuine arbiter actions (#5196; parent epic #3044).", "purpose_tldr": "Ordinary reject-rework-resubmit-approve review loops need no --force and never record a fake arbiter override.", "target_branch": "issue-5196-rework-is-not-an-override", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-09-28T19:28:39.365456+00:00"}
