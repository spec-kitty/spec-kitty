{"aggregate_id": "01M43AHQQYMDGJSZ9GQJGN42XX", "aggregate_type": "Mission", "event_id": "01M43AHSET0ZFGGDNA2B2T4TXY", "event_type": "MissionCreated", "payload": {"actor": "stijn.dejongh@sddevelopment.be", "created_at": "2026-10-04T11:24:54.209888+00:00", "friendly_name": "finalize-tasks: a failed run leaves the status surface as it found it", "mission_id": "01M43AHQQYMDGJSZ9GQJGN42XX", "mission_number": null, "mission_slug": "finalize-tasks-failed-run-restores-status-surface-01M43AHQ", "mission_type": "software-dev", "purpose_context": "When finalize-tasks fails at its final commit it restores the Mission files but keeps the per-WP status commits the bootstrap already made, so the status surface's branch advances and, for lanes and single_branch Missions, the checkout is left dirty against its own HEAD. This mission restores the status surface through the compare-and-swap ref-restore route and reports precisely any commit it cannot undo.", "purpose_tldr": "A failed finalize-tasks run undoes the per-WP status commits it made, for every topology (#5641).", "target_branch": "kitty/fix-5641-finalize-tasks-atomic-status", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-10-04T11:24:54.618101+00:00"}
