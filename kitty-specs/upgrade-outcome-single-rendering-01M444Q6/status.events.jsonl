{"aggregate_id": "01M444Q6NB61JZC101RH80VCH0", "aggregate_type": "Mission", "event_id": "01M444Q9CJTTV7J9G0GCN5JWD1", "event_type": "MissionCreated", "payload": {"actor": "stijn@sddevelopment.be", "created_at": "2026-10-04T19:02:15.040770+00:00", "friendly_name": "Upgrade reports one outcome", "mission_id": "01M444Q6NB61JZC101RH80VCH0", "mission_number": null, "mission_slug": "upgrade-outcome-single-rendering-01M444Q6", "mission_type": "software-dev", "purpose_context": "Today an upgrade that finds unresolved tool-surface drift on an otherwise up-to-date project prints 'Project is already up to date!' and exits 1, with no explanation in text mode. Automation treats every such run as a failure and operators cannot see why. This mission makes the upgrade command report a single outcome, so the closing line, the machine-readable status and the exit code are produced from the same value in every mode.", "purpose_tldr": "Make spec-kitty upgrade's final message, JSON status and exit code always agree, so a run never says it succeeded while exiting as a failure.", "target_branch": "issue-4925-upgrade-outcome-single-rendering", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-10-04T19:02:17.746152+00:00"}
