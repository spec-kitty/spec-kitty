{"aggregate_id": "01M4RXXHCX400P012JDH7DCNH1", "aggregate_type": "Mission", "event_id": "01M4RXXHH4EQ64DHRFBMJ4PKBJ", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-10-12T20:47:25.714601+00:00", "friendly_name": "Codex .agents/skills manifest-drift idempotency (#702)", "mission_id": "01M4RXXHCX400P012JDH7DCNH1", "mission_number": null, "mission_slug": "codex-skills-drift-01M4RXXH", "mission_type": "software-dev", "purpose_context": "The .agents/skills/spec-kitty.<command>/SKILL.md command-skill projection is a DERIVED, git-ignored surface, yet the command-skill installer classifies a manifest-owned projection whose on-disk bytes match neither the recorded hash nor the current render as a user edit requiring consent. In a second checkout the tracked manifest and the ignored output legitimately disagree, so untouched generated state reads as drift and is kept rather than regenerated, breaking idempotency against the manifest (GitHub #702).", "purpose_tldr": "upgrade/sync/init regenerate drifted DERIVED Codex command-skill projections instead of flagging them as user edits", "target_branch": "issue-702-codex-skills-drift", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-10-12T20:47:25.732614+00:00"}
