{"aggregate_id": "01M5DBWTRXZQ3ZJWGKX0KES8JP", "aggregate_type": "Mission", "event_id": "01M5DBWXJXM7N16GTCA68AGXXV", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-10-20T19:16:33.521703+00:00", "friendly_name": "Spec-conformant command skill names + Antigravity skills delivery", "mission_id": "01M5DBWTRXZQ3ZJWGKX0KES8JP", "mission_number": null, "mission_slug": "command-skill-names-and-antigravity-01M5DBWT", "mission_type": "software-dev", "purpose_context": "Generated command skills use dotted names (spec-kitty.<cmd>) that VS Code/Copilot, Cursor and OpenCode silently drop and the Agent Skills spec rejects, and Antigravity's legacy .agent/workflows surface stopped working on 2026-10-19. This mission renames the command skills to spec-conformant names, delivers them to Antigravity as skills, cleans up the dead surfaces Spec Kitty owns, and keeps generated frontmatter inside the spec.", "purpose_tldr": "Make Spec Kitty's command skills load in every harness and give Antigravity users working commands again.", "target_branch": "issue-6475-6470-command-skill-names", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-10-20T19:16:34.013368+00:00"}
