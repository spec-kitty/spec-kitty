{"aggregate_id": "01M78FG20SYR6NPAC6QYZY7KJT", "aggregate_type": "Mission", "event_id": "01M78FGAJ64N1N04SAYK1DREQE", "event_type": "MissionCreated", "payload": {"actor": "noreply@anthropic.com", "created_at": "2026-11-12T18:14:46.654728+00:00", "friendly_name": "Retire DocFX", "mission_id": "01M78FG20SYR6NPAC6QYZY7KJT", "mission_number": null, "mission_slug": "retire-docfx-01M78FG2", "mission_type": "software-dev", "purpose_context": "The docsite cutover (#6938) moved the deploy to the doc-kitty build; no CI job builds DocFX any more. This mission removes docs/docfx.json, every toc.yml, the DocFX template, the scripts ADR D-6 marks drop (and port scripts whose job doc-kitty now does), and the redirect map and manifest the ledgers superseded. Tests that guard a still-live invariant, such as which pages are published or that docs/reports is never published, are rebased on scripts/docs/_dockitty_contract.py. The operator waived the one-release gate; rollback becomes reverting this PR and #7558.", "purpose_tldr": "Remove DocFX, its config, template and DocFX-only scripts, and rebase the tests that guard live invariants on the doc-kitty contract (#6943)", "target_branch": "issue-6943-retire-docfx", "wp_count": 0}, "project_slug": "spec-kitty", "project_uuid": "8a4a7da6-a97c-4bb4-893a-b31664abfee4", "schema_version": "5.0.0", "timestamp": "2026-11-12T18:14:47.110591+00:00"}
